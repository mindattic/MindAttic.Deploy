<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet package source layout for MindAttic.Deploy.

  Two sources, intentionally ordered:

    1. lib/local-packages/  (relative to this file)
       Holds the MindAttic.* private packages this repo depends on (Vault).
       The folder is checked into git so GitHub-hosted builds can restore
       without seeing the developer's C:\LocalNuGet. Keep it small — only
       the versions actually referenced by the csproj files. Regenerate by
       copying the matching .nupkg from the producer repo's pack output.

    2. nuget.org
       Everything else. Standard public feed.

  When you bump MindAttic.Vault, drop the new .nupkg in lib/local-packages/
  AND update the PackageReference version in MindAttic.Deploy.Cli.csproj.
  Old .nupkg files can stay in the folder — NuGet picks the version
  requested by the csproj.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local-packages" value="./lib/local-packages" />
    <add key="nuget.org"      value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
